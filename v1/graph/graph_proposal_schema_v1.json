{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jasperskkr/PLL_EVALAGENT/schema/graph-proposal-1.0",
  "title": "Agent Graph Proposal v1",
  "type": "object",
  "required": ["proposal_id", "action", "subject", "rationale", "evidence_ids", "requested_verification", "status"],
  "properties": {
    "proposal_id": {"type": "string", "minLength": 1},
    "action": {"enum": ["add_node", "add_edge", "modify_node", "modify_edge", "remove_node", "remove_edge"]},
    "subject": {"type": "object"},
    "rationale": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "requested_verification": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["schema_validation", "unit_check", "block_tb", "parameter_sweep", "sensitivity", "system_tb", "independent_evaluator"]}
    },
    "status": {"const": "proposed"},
    "modify_system_spec": {"const": false},
    "declare_pass": {"const": false}
  },
  "additionalProperties": false
}
