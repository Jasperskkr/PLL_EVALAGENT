{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jasperskkr/PLL_EVALAGENT/schema/graph-2.0",
  "title": "PLL_EVALAGENT TypedGraph v2",
  "description": "Four-role graph vocabulary for deterministic validation. Public Block Graph semantics are carried by semantic_role; plane is implementation metadata for provenance/authority, not a Block Graph layer.",
  "type": "object",
  "required": ["graph_id", "graph_version", "nodes", "edges"],
  "properties": {
    "graph_id": {"type": "string", "minLength": 1},
    "graph_version": {"const": "2.0"},
    "metadata": {"type": "object"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "properties", "plane", "authority", "scope", "mutability", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "architecture_block",
            "behavioral_variable",
            "behavioral_output",
            "block_requirement",
            "candidate",
            "candidate_knob",
            "capability_region",
            "system_feasible_region",
            "context",
            "context_variable",
            "contract",
            "design_space",
            "design_variable",
            "evaluation",
            "factor",
            "evidence",
            "measured_result",
            "measurement_contract",
            "operator",
            "port",
            "realized_instance",
            "schema_definition",
            "signal",
            "system_metric",
            "system_requirement",
            "uncertainty_model",
            "validity_domain"
          ]
        },
        "semantic_role": {"enum": ["architecture", "behavior", "influence", "evidence"]},
        "plane": {
          "description": "Implementation metadata for provenance/authority grouping; not a public Block Graph semantic layer.",
          "enum": ["schema", "contract", "realization", "evidence"]
        },
        "authority": {"enum": ["schema_compiler", "contract_builder", "agent_or_allocator", "deterministic_allocator", "system_spec_input", "realization_compiler", "deterministic_simulator", "deterministic_evaluator", "deterministic_graph_compiler"]},
        "scope": {"enum": ["global", "reusable", "run_specific"]},
        "mutability": {"enum": ["immutable", "versioned", "proposed_then_immutable", "append_only"]},
        "provenance": {"type": "object", "minProperties": 1},
        "owner": {"type": "string"},
        "status": {"enum": ["proposed", "supported", "tested", "partially_validated", "validated", "rejected"]},
        "properties": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "factor"}}},
          "then": {"properties": {"properties": {"$ref": "#/$defs/factor_properties"}}}
        }
      ]
    },
    "factor_properties": {
      "type": "object",
      "required": [
        "factor_id",
        "factor_type",
        "name",
        "input_refs",
        "output_refs",
        "relation_kind",
        "model_kind",
        "context_refs",
        "evidence_refs",
        "verification_status",
        "source_run_ids",
        "version"
      ],
      "properties": {
        "factor_id": {"type": "string", "minLength": 1},
        "factor_type": {"enum": ["system_response", "allocation", "constraint", "block_response"]},
        "name": {"type": "string", "minLength": 1},
        "input_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "output_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "relation_kind": {"type": "string", "minLength": 1},
        "model_kind": {"type": "string", "minLength": 1},
        "model_ref": {"type": ["string", "null"]},
        "artifact_ref": {"type": ["string", "null"]},
        "validity_domain": {"type": ["object", "null"]},
        "context_refs": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "uncertainty": {"type": ["object", "null"]},
        "verification_status": {"type": "string"},
        "source_run_ids": {"type": "array", "items": {"type": "string"}},
        "artifact_hashes": {"type": ["object", "null"]},
        "version": {"type": "string", "minLength": 1},
        "metadata": {"type": "object"}
      }
    },
    "edge": {
      "type": "object",
      "required": ["source", "target", "type", "properties", "plane", "authority", "scope", "mutability", "provenance"],
      "properties": {
        "source": {"type": "string"},
        "target": {"type": "string"},
        "type": {
          "enum": [
            "allocates",
            "behavioral_dependency",
            "candidate_of",
            "connects_to",
            "constrains",
            "contains",
            "contract_dependency",
            "covers",
            "derived_from",
            "evaluates",
            "feedback",
            "factor_input",
            "factor_output",
            "input_to",
            "measured_by",
            "noise_transfer",
            "produces",
            "provides",
            "realizes",
            "requires",
            "selected_for",
            "sensitivity_evidence",
            "shortcut",
            "signal_flow",
            "supported_by",
            "supports",
            "system_influence",
            "uses_context",
            "valid_in",
            "validated_by",
            "verifies_requirement",
            "yields_verdict"
          ]
        },
        "plane": {
          "description": "Implementation metadata for provenance/authority grouping; not a public Block Graph semantic layer.",
          "enum": ["schema", "contract", "realization", "evidence"]
        },
        "authority": {"enum": ["schema_compiler", "contract_builder", "agent_or_allocator", "deterministic_allocator", "system_spec_input", "realization_compiler", "deterministic_simulator", "deterministic_evaluator", "deterministic_graph_compiler"]},
        "scope": {"enum": ["global", "reusable", "run_specific"]},
        "mutability": {"enum": ["immutable", "versioned", "proposed_then_immutable", "append_only"]},
        "provenance": {"type": "object", "minProperties": 1},
        "status": {"enum": ["proposed", "supported", "tested", "partially_validated", "validated", "rejected"]},
        "properties": {"type": "object"}
      }
    }
  }
}
