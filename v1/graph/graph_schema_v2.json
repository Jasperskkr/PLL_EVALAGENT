{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jasperskkr/PLL_EVALAGENT/schema/graph-2.0",
  "title": "PLL_EVALAGENT TypedGraph v2",
  "description": "Four-layer graph vocabulary for Agent proposals and deterministic validation.",
  "type": "object",
  "required": ["graph_id", "graph_version", "nodes", "edges"],
  "properties": {
    "graph_id": {"type": "string", "minLength": 1},
    "graph_version": {"const": "2.0"},
    "metadata": {"type": "object"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "layer", "properties"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "architecture_block",
            "behavioral_output",
            "block_requirement",
            "candidate",
            "capability_region",
            "context",
            "context_variable",
            "contract",
            "design_space",
            "design_variable",
            "evaluation",
            "evidence",
            "measurement_contract",
            "operator",
            "port",
            "realized_instance",
            "signal",
            "system_metric",
            "system_requirement",
            "uncertainty_model",
            "validity_domain"
          ]
        },
        "layer": {"enum": ["interface", "behavior", "allocation", "verification"]},
        "owner": {"type": "string"},
        "status": {"enum": ["proposed", "supported", "tested", "partially_validated", "validated", "rejected"]},
        "properties": {"type": "object"}
      }
    },
    "edge": {
      "type": "object",
      "required": ["source", "target", "type", "properties"],
      "properties": {
        "source": {"type": "string"},
        "target": {"type": "string"},
        "type": {
          "enum": [
            "allocates",
            "behavioral_dependency",
            "candidate_of",
            "connects_to",
            "constrains",
            "contains",
            "contract_dependency",
            "covers",
            "derived_from",
            "evaluates",
            "feedback",
            "input_to",
            "measured_by",
            "noise_transfer",
            "produces",
            "provides",
            "realizes",
            "requires",
            "selected_for",
            "sensitivity_evidence",
            "shortcut",
            "signal_flow",
            "supported_by",
            "supports",
            "system_influence",
            "uses_context",
            "valid_in",
            "validated_by",
            "verifies_requirement",
            "yields_verdict"
          ]
        },
        "status": {"enum": ["proposed", "supported", "tested", "partially_validated", "validated", "rejected"]},
        "properties": {"type": "object"}
      }
    }
  }
}
