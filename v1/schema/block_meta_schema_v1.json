{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jasperskkr/PLL_EVALAGENT/schema/block-meta-1.0",
  "title": "PLL_EVALAGENT BlockMetaSchema v1",
  "description": "Fixed Architecture/Behavior/Influence/Evidence block metadata shape. Domain values and feasibility are validated by deterministic BlockTB/SystemTB.",
  "type": "object",
  "required": [
    "schema_version",
    "object_type",
    "block_id",
    "block_type",
    "architecture",
    "behavior",
    "influence",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "block-meta-1.0"},
    "object_type": {"const": "block_meta"},
    "block_id": {"type": "string", "minLength": 1},
    "block_type": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"},
    "architecture": {
      "type": "object",
      "required": ["function", "ports", "context_inputs", "connections"],
      "properties": {
        "function": {"type": "string", "minLength": 1},
        "ports": {"type": "array", "items": {"$ref": "#/$defs/port"}},
        "context_inputs": {"type": "array", "items": {"type": "string"}},
        "connections": {"type": "array", "items": {"type": "string"}}
      }
    },
    "behavior": {
      "type": "object",
      "required": ["metrics", "context_dependencies", "evaluation_methods"],
      "properties": {
        "metrics": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "context_dependencies": {"type": "object"},
        "evaluation_methods": {"type": "object"}
      }
    },
    "influence": {"type": "array", "items": {"type": "object"}},
    "evidence": {
      "type": "object",
      "required": ["measurement_contracts", "validity_domain", "uncertainty", "evidence"],
      "properties": {
        "measurement_contracts": {"type": "array", "items": {"type": "object"}},
        "validity_domain": {"type": "object"},
        "uncertainty": {"type": "object"},
        "evidence": {"type": "array", "items": {"type": "object"}}
      }
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "required": ["name", "direction", "signal_type", "unit", "datatype"],
      "properties": {
        "name": {"type": "string"},
        "direction": {"enum": ["in", "out", "inout"]},
        "signal_type": {"type": "string"},
        "unit": {"type": "string"},
        "datatype": {"type": "string"}
      }
    },
    "field": {
      "type": "object",
      "required": ["name", "role", "unit", "datatype", "depends_on", "evaluation_method", "description"],
      "properties": {
        "name": {"type": "string"},
        "role": {"enum": ["system_context", "design_variable", "intermediate_variable", "performance_metric", "hard_constraint", "objective", "validity_condition", "interaction_variable"]},
        "unit": {"type": "string"},
        "datatype": {"type": "string"},
        "depends_on": {"type": "array", "items": {"type": "string"}},
        "evaluation_method": {"type": "string"},
        "description": {"type": "string"},
        "validity": {"type": "object"}
      }
    }
  }
}
