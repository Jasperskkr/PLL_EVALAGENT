{
  "schema_version": "pll-physics-experiment-2.0",
  "topology": "integer_n_cppll",
  "conventions": {
    "vco_f0": "frequency_at_zero_volts",
    "phase_error": "reference_minus_feedback_rad",
    "lf_topology": "C1_shunt_Rz_series_C2",
    "cp_leakage": "positive_injected_into_lf"
  },
  "system_spec": {
    "version": "0",
    "draft": true,
    "source": "User Stage 1 research targets, 2026-11-04; not frozen",
    "metrics": [
      {"metric": "output_frequency_Hz", "unit": "Hz", "min": 80000000, "max": 80000000, "tolerance": 0.000001, "evaluator": "M1", "protocol": "conditional_locked_tuning_frequency", "source": "User: 10 MHz x 8; conditional static frequency, not a transient measurement"},
      {"metric": "BW_Hz", "unit": "Hz", "min": 150000, "max": 300000, "tolerance": 0, "evaluator": "M1", "protocol": "continuous_normalized_T_first_downward_minus3dB", "source": "User: experimental BW target"},
      {"metric": "PM_deg", "unit": "deg", "min": 50, "tolerance": 0, "evaluator": "M1", "protocol": "180_plus_continuous_L_phase_at_UGF", "source": "User: experimental PM target"}
    ]
  },
  "diagnostic_metrics": ["UGF_Hz"],
  "block_space": {
    "version": "2",
    "capability_claim": "BEHAVIORAL_DECLARED_DOMAIN_ONLY",
    "variables": {
      "f_ref": {"block": "Reference", "role": "Context", "unit": "Hz", "fixed": 10000000, "default": 10000000, "source": "User Stage 1", "validity": "positive reference frequency"},
      "N": {"block": "Divider", "role": "BlockSpec", "unit": "1", "fixed": 8, "default": 8, "source": "User Stage 1", "validity": "positive integer"},
      "Icp": {"block": "CP", "role": "BlockSpec", "unit": "A", "range": {"min": 0.00005, "max": 0.0002}, "default": 0.0001, "source": "Stage 1 declared local domain about MATLAB pll_params; not a measured capability", "validity": "positive symmetric ideal current"},
      "Rz": {"block": "LF", "role": "BlockSpec", "unit": "Ohm", "range": {"min": 2000, "max": 8000}, "default": 3820, "source": "Stage 1 declared local domain; default MATLAB pll_params", "validity": "positive ideal series resistance"},
      "C1": {"block": "LF", "role": "BlockSpec", "unit": "F", "choices": [5e-11, 1e-10, 2e-10], "default": 1e-10, "source": "Stage 1 declared choices; default MATLAB pll_params", "validity": "positive shunt capacitance"},
      "C2": {"block": "LF", "role": "BlockSpec", "unit": "F", "choices": [5e-10, 1e-9, 2e-9], "default": 1e-9, "source": "Stage 1 declared choices; default MATLAB pll_params", "validity": "positive series-branch capacitance"},
      "f0": {"block": "VCO", "role": "BlockSpec", "unit": "Hz", "range": {"min": 60000000, "max": 76000000}, "default": 72000000, "source": "Stage 1 declared local domain; default MATLAB pll_params", "validity": "zero-voltage intercept; positive f(V) on full domain; candidate tuning must be checked"},
      "Kvco": {"block": "VCO", "role": "BlockSpec", "unit": "Hz/V", "range": {"min": 10000000, "max": 40000000}, "default": 20000000, "source": "Stage 1 declared local domain; default MATLAB pll_params", "validity": "positive linear frequency slope, not angular gain"},
      "Vctrl_min": {"block": "VCO", "role": "BlockSpec", "unit": "V", "fixed": 0, "default": 0, "source": "User / MATLAB ideal point", "validity": "strictly below Vctrl_max; M1 lock point interior"},
      "Vctrl_max": {"block": "VCO", "role": "BlockSpec", "unit": "V", "fixed": 1.2, "default": 1.2, "source": "User / MATLAB ideal point", "validity": "declared functional limit, not CP compliance from PDK"},
      "Kvco2": {"block": "VCO", "role": "Context", "unit": "Hz/V^2", "fixed": 0, "default": 0, "source": "MATLAB pll_params; Stage 1 supported subset", "validity": "nonzero is UNSUPPORTED"},
      "CP_mismatch": {"block": "CP", "role": "Context", "unit": "1", "fixed": 0, "default": 0, "source": "MATLAB pll_params; Stage 1 supported subset", "validity": "(Iup-Idown)/Icp; nonzero is UNSUPPORTED"},
      "CP_leakage": {"block": "CP", "role": "Context", "unit": "A", "fixed": 0, "default": 0, "source": "MATLAB pll_params; Stage 1 supported subset", "validity": "positive injection; nonzero is UNSUPPORTED"},
      "q0": {"block": "CP", "role": "Context", "unit": "C", "fixed": 0, "default": 0, "source": "Python v1 semantic audit; explicit zero for M1", "validity": "balance charge including proxy demand; nonzero is UNSUPPORTED"},
      "PFD_reset_delay": {"block": "PFD", "role": "Context", "unit": "s", "fixed": 0, "default": 0, "source": "MATLAB pll_params; Stage 1 supported subset", "validity": "nonzero is UNSUPPORTED; negative or >= reference period is OUT_OF_DOMAIN"},
      "Cload": {"block": "LF", "role": "Context", "unit": "F", "fixed": 0, "default": 0, "source": "Python v1 semantic audit; no proxy load migrated", "validity": "nonzero is UNSUPPORTED"},
      "Gload": {"block": "LF", "role": "Context", "unit": "S", "fixed": 0, "default": 0, "source": "Explicit unloaded ideal LF; not inferred from v1 Rload", "validity": "nonzero is UNSUPPORTED"}
    }
  }
}
